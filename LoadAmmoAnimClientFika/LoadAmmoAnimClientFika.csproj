<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>Manimal.LoadAmmoAnim.Fika</RootNamespace>
    <AssemblyName>LoadAmmoAnimClientFika</AssemblyName>
    <Nullable>disable</Nullable>
    <Authors>Manimal</Authors>
    <AssemblyVersion>$(ModVersion).0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Configurations>Debug;Release</Configurations>
    <Version>$(ModVersion)</Version>
    <LangVersion>latest</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Build-order dependency on the main client. ReferenceOutputAssembly=true so
    we can call into LoadAmmoAnimDriver.StartBundleAnim etc. directly. The Private=false
    keeps the main DLL out of our publish output so we ship only LoadAmmoAnimClientFika.dll.
  -->
  <ItemGroup>
    <ProjectReference Include="..\LoadAmmoAnimClient\LoadAmmoAnimClient.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fika lives at the Fika dev install. matches the FikaSptRoot layout. -->
    <Reference Include="Fika.Core">
      <HintPath>$(FikaSptRoot)\BepInEx\plugins\Fika\Fika.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(FikaSptRoot)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>$(FikaSptRoot)\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(FikaSptRoot)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(FikaSptRoot)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTushonka.Reflection">
      <HintPath>$(FikaSptRoot)\BepInEx\plugins\sptushonka\SPTushonka.Reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(FikaSptRoot)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(FikaSptRoot)\BepInEx\interop\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(FikaSptRoot)\BepInEx\interop\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort.Unity">
      <HintPath>$(FikaSptRoot)\BepInEx\interop\Comfort.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(FikaSptRoot)\BepInEx\interop\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(FikaSptRoot)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ItemComponent.Types">
      <HintPath>$(FikaSptRoot)\BepInEx\interop\ItemComponent.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ItemTemplate.Types">
      <HintPath>$(FikaSptRoot)\BepInEx\interop\ItemTemplate.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Drop the built DLL alongside the main client DLL in the BepInEx plugins
    folder. main client's side-loader picks it up at Load when Fika is detected.
  -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <MakeDir Directories="$(FikaSptRoot)\BepInEx\plugins\LoadAmmoAnim" />
    <Exec Command="copy &quot;$(TargetPath)&quot; &quot;$(FikaSptRoot)\BepInEx\plugins\LoadAmmoAnim\$(TargetFileName)&quot;" />
  </Target>

</Project>
